{
  "name": "sauna-ui-test",
  "private": true,
  "version": "0.1.0",
  "description": "Headless browser harness for data/*.html — mock ESP32 device + Playwright tests",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "PWDEBUG=1 playwright test",
    "serve": "node mock-server.mjs",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "ws": "^8.18.0"
  }
}
